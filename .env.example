# ====== rmutimt_gallery – ตัวอย่างไฟล์ตั้งค่า ======
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  (คำสั่ง: cp .env.example .env)
# บนโฮสที่ตั้ง environment variable ผ่านแผงควบคุมได้ (Render / Railway) ไม่ต้องมีไฟล์ .env

# ---- ฐานข้อมูล Supabase (PostgreSQL) ----
# เอามาจาก Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
# (เลือกแท็บ URI แล้วแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลจริง)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- หรือจะแยกเป็นตัวแปรก็ได้ (ใช้แทน DATABASE_URL) ---
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.xxxxxxxxxxxx
# DB_PASS=YOUR-DB-PASSWORD
# DB_SSLMODE=require

# ---- OpenDrive (ระบบเก็บไฟล์ผลงาน) ----
OD_USERNAME=your-opendrive-email
OD_PASSWORD=your-opendrive-password
OD_FOLDER_ID=your-opendrive-folder-id
OD_API_BASE=https://dev.opendrive.com/api/v1
