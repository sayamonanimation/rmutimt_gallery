# ====== rmutimt_gallery – ตัวอย่างไฟล์ตั้งค่า ======
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง   (cp .env.example .env)
# ไฟล์ .env จะไม่ถูก commit ขึ้น GitHub (อยู่ใน .gitignore) — ปลอดภัยสำหรับเก็บรหัส

# ---- ฐานข้อมูล MySQL / MariaDB ----
# ค่าเหล่านี้ได้จากแผงควบคุมของโฮส (เช่น InfinityFree > MySQL Databases)
DB_HOST=sqlXXX.epizy.com
DB_PORT=3306
DB_NAME=if0_00000000_rmutimt_gallery
DB_USER=if0_00000000
DB_PASS=your-db-password

# ---- OpenDrive (ระบบเก็บไฟล์ผลงาน) ----
OD_USERNAME=rmuticlass@gmail.com
OD_PASSWORD=your-opendrive-password
OD_FOLDER_ID=your-opendrive-folder-id
OD_API_BASE=https://dev.opendrive.com/api/v1
